{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-capture.sh"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "emacsclient -e '(my/magit-refresh-visible)' >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "agentPushNotifEnabled": true
}
